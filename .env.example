# ==============================================================================
# Enterprise Task & Project Orchestrator Configuration
# ==============================================================================

# Application Environment: 'development' | 'testing' | 'production'
ENVIRONMENT=development
DEBUG=true
APP_NAME="TaskSphere Enterprise API"
APP_VERSION="1.0.0"
API_V1_PREFIX="/api/v1"

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# Security & Authentication
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY=enterprise-super-secret-dev-key-change-in-production-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite Async (default for zero-friction setup):
DATABASE_URL=sqlite+aiosqlite:///./tasksphere.db
# PostgreSQL Async example (uncomment for production):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tasksphere

# CORS Configuration (Comma-separated list or JSON array)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]

# First Admin Seed Setup
FIRST_ADMIN_EMAIL=admin@tasksphere.io
FIRST_ADMIN_PASSWORD=AdminSecurePass123!
FIRST_ADMIN_FULL_NAME="System Administrator"
